{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coderyaz856/Semantic-Scale-Geometry/schemas/experiment.schema.json",
  "title": "Semantic Scale Geometry experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "scales", "background", "model"],
  "properties": {
    "format": {"const": "semantic-scale-geometry/experiment/1"},
    "scales": {"type": "string", "minLength": 1},
    "background": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "device": {"type": "string", "minLength": 1, "default": "cpu"},
        "pooling": {"enum": ["mean", "cls"], "default": "mean"},
        "max_length": {"type": "integer", "minimum": 1, "default": 48},
        "batch_size": {"type": "integer", "minimum": 1, "default": 16}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "removals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0},
          "default": [0, 1, 3]
        },
        "random_draws": {"type": "integer", "minimum": 1, "default": 10000},
        "bootstrap_draws": {"type": "integer", "minimum": 1, "default": 2000},
        "seed": {"type": "integer", "minimum": 0, "default": 1},
        "null_replicates": {"type": "integer", "minimum": 1, "default": 50},
        "subspace_condition": {"type": "string", "minLength": 1, "default": "carrier"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kernel_binary": {"type": "string", "minLength": 1, "default": "sg-measure"},
        "subspace_binary": {"type": "string", "minLength": 1, "default": "sg-subspace"},
        "report_script": {"type": "string", "minLength": 1, "default": "tools/report.py"}
      }
    }
  }
}
